# Server
PORT=3000

# Where placement results should be sent.
RESULT_RECIPIENT_EMAIL=teacher@example.com
EMAIL_FROM="English Placement <placement@example.com>"

# Required for /admin on public hosting.
ADMIN_PASSWORD=change-this-password

# Optional. On hosting, point this to a persistent disk/mounted folder.
DATA_DIR=./data

# Option 1: SMTP. Works with most mail providers.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=placement@example.com
SMTP_PASS=replace-with-app-password

# Option 2: system sendmail. Leave SMTP_HOST empty and set this to true.
# EMAIL_TRANSPORT=sendmail

# Optional: send a copy to the student.
SEND_STUDENT_COPY=false
